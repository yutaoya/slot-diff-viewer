{
  "hosting": {
    "public": "build-theme-preview",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.xlsx"
    ],
    "rewrites": [
      {
        "source": "/agtmagtm",
        "destination": "/agtmagtm/index.html"
      },
      {
        "source": "/agtmagtm/**",
        "destination": "/agtmagtm/index.html"
      }
    ],
    "headers": [
      {
        "source": "/agtmagtm/manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
