{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/agtmagtm", "destination": "/agtmagtm/index.html" },
      { "source": "/agtmagtm/**", "destination": "/agtmagtm/index.html" }
    ],
    "headers": [
      {
        "source": "/agtmagtm/manifest.json",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
